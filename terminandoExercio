  }
}
class Executivo extends Passagem{
 static float calcularExecutivo(){
 float valorfinal = (valorbase*35)/100 + valorbase;
 return valorfinal;
}
   static void imprimir(){
System.out.println("custa" + calcularExecutivo());
   }

}
