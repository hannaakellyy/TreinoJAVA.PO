import java.util.*;

class Cliente{
  private int cpf;
  private String nome;

  Cliente(int cpf, String nome){
    this.cpf = cpf;
    this.nome = nome;
    
  }
  public void setcpf(int cpf){
    this.cpf = cpf;
  }
  public int getcpf(){
    return this.cpf;
  }
  public void setnome(String nome){
    this.nome = nome;
  }
  public String getnome(){
    return this.nome;
  }

  void exibir(){
    System.out.print(nome + "seu cpf é:" + cpf);
  }
}

class Pedido{
  private int numero;
  Cliente cliente;

  Pedido (int numero, int cpf, String nome){
    this.numero = numero;
    this.cliente = new Cliente(cpf, nome);
  }
}

public class Main{
  public static void main (String[]args){
    System.out.print("testando o codigo");

    Pedido pedido1 = new Pedido(20, 2619093, "Hanna");

    pedido1.cliente.exibir();
  }
}